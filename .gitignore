# ============================================================

*.tmp
*.temp
*.bak
*.swp
*.swo

*.cache


# ============================================================
# ZIP / ARCHIVES
# ============================================================

*.zip
*.tar
*.tar.gz
*.7z
*.rar


# ============================================================
# NODE / FRONTEND
# ============================================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.pnpm-debug.log*

dist/
.next/
.nuxt/
.cache/


# ============================================================
# ANDROID / GRADLE
# ============================================================

.gradle/
.idea/
build/
captures/

local.properties

*.apk
*.aab

# Android generated files
.externalNativeBuild/
.cxx/


# ============================================================
# FLUTTER
# ============================================================

.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages

.pub-cache/
.pub/

build/

# Flutter generated files
*.lock


# ============================================================
# FASTAPI / BACKEND TEMP FILES
# ============================================================

instance/

# Uploaded user images
uploads/
temp_uploads/


# ============================================================
# GENERATED DOCUMENTATION / REPORTS
# ============================================================

# Uncomment these if reports become generated automatically:
# reports/generated/
# docs/generated/


# ============================================================
# LOCAL DEVELOPMENT
# ============================================================

local/
tmp/
temp/

# OS/editor history
.history/


# ============================================================
# PROJECT-SPECIFIC LARGE FILES
# ============================================================

# HAM10000
data/raw/HAM10000/
data/raw/HAM10000_images_part_1/
data/raw/HAM10000_images_part_2/

# Any future ISIC datasets
data/raw/ISIC/

# PH2 dataset
data/raw/PH2/


# ============================================================
# KEEP THESE IN GIT
# ============================================================

# Example environment template
!.env.example

# Project documentation
!README.md
!docs/

# Source code
!src/

# Tests
!tests/

# Notebooks
!notebooks/

# Requirements
!requirements.txt
!requirements*.txt